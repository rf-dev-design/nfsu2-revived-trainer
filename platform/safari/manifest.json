{
  "manifest_version": 3,
  "name": "U2 Revived Trainer",
  "short_name": "U2 Trainer",
  "version": "2.2.2",
  "description": "Classic-style trainer for Underground 2 Revived on nfsu2.xyz: bank editor, boost, jump, nitrous, warps. Car cheats offline-only.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://nfsu2.xyz/*"
      ],
      "js": [
        "trainer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "homepage_url": "https://github.com/rf-dev-design/nfsu2-revived-trainer",
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "17.0"
    }
  }
}